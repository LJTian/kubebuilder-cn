msgstr ""

#: src/migration/discovery-commands.md:41
msgid "API types in `api/` directory (some projects use `apis/`)"
msgstr ""

#: src/migration/discovery-commands.md:42
msgid ""
"Controllers in `controllers/`, `internal/controller/`, or `pkg/controllers/`"
