"    \n"
"    // Validation with custom reason\n"
"    // +kubebuilder:validation:XValidation:rule=&#34;self.x &lt;= self.maxX&#34;,message=&#34;x cannot be greater than maxX&#34;,reason=&#34;FieldValueInvalid&#34;\n"
