"# [NETWORK POLICY] Control ingress to metrics and webhook ports.\n"
msgstr ""
"# [NETWORK POLICY] Control ingress to metrics and webhook ports.\n"

#: src/reference/metrics.md:364
msgid "Allow metrics traffic from pods in namespaces labeled 'metrics"
msgstr "允许来自带有 'metrics 标签的命名空间中的 Pod 的 metrics 流量"

