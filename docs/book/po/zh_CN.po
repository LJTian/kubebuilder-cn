msgid "\"Writing scaffold for you to edit...\""
msgstr ""

#: src/plugins/extending/extending_cli_features_and_plugins.md:194
msgid ""
"// Initialize the machinery.Scaffold that will write the boilerplate file to "
"disk\n"
"\t// The boilerplate file needs to be scaffolded as a separate step as it is "
"going to\n"
"\t// be used by the rest of the files, even those scaffolded in this command "
"call.\n"
msgstr "// 初始化将把样板文件写入磁盘的机器架构。\n\t// 样板文件需要作为一个单独步骤进行搭建，因为它将被\n\t// 其他文件使用，包括在此命令调用中搭建的文件。"

#: src/plugins/extending/extending_cli_features_and_plugins.md:213
msgid "Example: Overwriting a File in a Plugin"
msgstr "示例：在插件中覆盖文件"

