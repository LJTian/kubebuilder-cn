"    TargetPort intstr.IntOrString\n"
"    "
msgstr ""
"    // +k8s:immutable\n"
"    // +required\n"
"    Port intstr.IntOrString\n"
"    \n"
"    // +k8s:immutable\n"
"    // +optional\n"
"    TargetPort intstr.IntOrString\n"
