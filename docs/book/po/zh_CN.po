msgstr "Kubebuilder CLI 版本 > 3.11.0"

#: src/plugins/extending/external-plugins.md:123
msgid "An executable for the external plugin"
msgstr "外部插件的可执行文件"

#: src/plugins/extending/external-plugins.md:124
msgid "Plugin path configuration using `${EXTERNAL_PLUGINS_PATH}` or default OS-based paths:"
msgstr "使用 `${EXTERNAL_PLUGINS_PATH}` 或默认操作系统路径进行插件路径配置："

#: src/plugins/extending/external-plugins.md:125
msgid "Linux: `$HOME/.config/kubebuilder/plugins/${name}/${version}/${name}`"
msgstr "Linux: `$HOME/.config/kubebuilder/plugins/${name}/${version}/${name}`"

#: src/plugins/extending/external-plugins.md:126
msgid "macOS: `~/Library/Application Support/kubebuilder/plugins/${name}/${version}/${name}`"
