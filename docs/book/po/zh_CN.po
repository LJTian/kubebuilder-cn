#: src/cronjob-tutorial/basic-project.md:334
msgid ""
"# go-install-tool will 'go install' any package with custom target and name "
"of binary, if it doesn't exist"
msgstr "# go-install-tool 将对任何包执行 'go install'，并使用自定义目标和二进制文件名称，如果该文件不存在的话。"

#: src/cronjob-tutorial/basic-project.md:335
msgid "# $1 - target path with name of binary"
msgstr "# $1 - 目标路径和二进制文件名称"

#: src/cronjob-tutorial/basic-project.md:336
msgid "# $2 - package url which can be installed"
msgstr "# $2 - 可安装的包 URL"

#: src/cronjob-tutorial/basic-project.md:337
msgid "# $3 - specific version of package"
msgstr "# $3 - 特定版本的包"

#: src/cronjob-tutorial/basic-project.md:339
msgid ""
"@[ -f \"$(1)-$(3)\" ] || { \\\n"
"set -e; \\\n"
"package=$(2)@$(3) ;\\\n"
"echo \"Downloading $${package}\" ;\\\n"
"rm -f $(1) || true ;\\\n"
"GOBIN=$(LOCALBIN) go install $${package} ;\\\n"
"mv $(1) $(1)-$(3) ;\\\n"
"} ;\\\n"
"ln -sf $(1)-$(3) $(1)\n"
msgstr "@[ -f \"$(1)-$(3)\" ] || { \\ 
set -e; \\ 
package=$(2)@$(3) ;\\ 
echo \"正在下载 $${package}\" ;\\ 
rm -f $(1) || true ;\\ 
GOBIN=$(LOCALBIN) go install $${package} ;\\ 
mv $(1) $(1)-$(3) ;\\ 
} ;\\ 
ln -sf $(1)-$(3) $(1)"

