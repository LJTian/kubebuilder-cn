"    // +default=[80,443]\n"
"    Ports []int\n"
"    \n"
"    // Object default (JSON format)\n"
"    // +default={&#34;policy&#34;: &#34;delete&#34;}\n"
"    Config map[string]interface{}\n"
"    "
msgstr ""
"    // String default (note the JSON quotes)\n"
"    // +default=&#34;ClusterIP&#34;\n"
"    ServiceType string\n"
"    \n"
"    // Integer default\n"
"    // +default=3\n"
