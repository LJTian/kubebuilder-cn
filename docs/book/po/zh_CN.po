"         namespaced: true\n"
"       controller: true\n"
"       domain: tutorial.kubebuilder.io\n"
"       group: batch\n"
"       kind: CronJob\n"
"       path: tutorial.kubebuilder.io/project/api/batch/v1  # Updated path\n"
"       version: v1\n"
"     ```\n"
